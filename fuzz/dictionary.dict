# libFuzzer dictionary for .fec filings: the tokens a mutator would take a
# long time to discover byte by byte. Structure first, then form and
# schedule tokens (from data/fec-csv-sources and src/parser/form.rs), then
# codes and values that drive validator and reconciler branches.

# Structure
hdr="HDR"
fec="FEC"
fs="\x1c"
comma=","
quote="\""
crlf="\x0d\x0a"
lf="\x0a"
begintext="[BEGINTEXT]"
endtext="[ENDTEXT]"
old_header="/* Header"
old_ver="FEC_Ver_# = "
bom="\xef\xbb\xbf"

# Spec versions (header column 3)
v3="3.00"
v5_0="5.0"
v5_1="5.1"
v5_2="5.2"
v5_3="5.3"
v6_1="6.1"
v6_4="6.4"
v7_0="7.0"
v8_0="8.0"
v8_2="8.2"
v8_3="8.3"
v8_4="8.4"
v8_5="8.5"
vP="P3.4"
vsp="8.5 "

